--cpu Cortex-M3
"ckyff\startup_stm32f103xb.o"
"ckyff\main.o"
"ckyff\stm32f1xx_it.o"
"ckyff\stm32f1xx_hal_msp.o"
"ckyff\stm32f1xx_hal_gpio_ex.o"
"ckyff\stm32f1xx_hal.o"
"ckyff\stm32f1xx_hal_rcc.o"
"ckyff\stm32f1xx_hal_rcc_ex.o"
"ckyff\stm32f1xx_hal_gpio.o"
"ckyff\stm32f1xx_hal_dma.o"
"ckyff\stm32f1xx_hal_cortex.o"
"ckyff\stm32f1xx_hal_pwr.o"
"ckyff\stm32f1xx_hal_flash.o"
"ckyff\stm32f1xx_hal_flash_ex.o"
"ckyff\stm32f1xx_hal_exti.o"
"ckyff\system_stm32f1xx.o"
--strict --scatter "CKYFF\CKYFF.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "CKYFF.map" -o CKYFF\CKYFF.axf