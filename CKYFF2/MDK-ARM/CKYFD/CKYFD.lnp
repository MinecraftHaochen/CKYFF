--cpu Cortex-M3
"ckyfd\startup_stm32f103xb.o"
"ckyfd\main.o"
"ckyfd\stm32f1xx_it.o"
"ckyfd\stm32f1xx_hal_msp.o"
"ckyfd\stm32f1xx_hal_gpio_ex.o"
"ckyfd\stm32f1xx_hal_tim.o"
"ckyfd\stm32f1xx_hal_tim_ex.o"
"ckyfd\stm32f1xx_hal.o"
"ckyfd\stm32f1xx_hal_rcc.o"
"ckyfd\stm32f1xx_hal_rcc_ex.o"
"ckyfd\stm32f1xx_hal_gpio.o"
"ckyfd\stm32f1xx_hal_dma.o"
"ckyfd\stm32f1xx_hal_cortex.o"
"ckyfd\stm32f1xx_hal_pwr.o"
"ckyfd\stm32f1xx_hal_flash.o"
"ckyfd\stm32f1xx_hal_flash_ex.o"
"ckyfd\stm32f1xx_hal_exti.o"
"ckyfd\system_stm32f1xx.o"
--strict --scatter "CKYFD\CKYFD.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "CKYFD.map" -o CKYFD\CKYFD.axf